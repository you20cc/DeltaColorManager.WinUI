<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DeltaColorManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="三角洲一键颜色管理">

    <!-- 背景跟随主题(浅色修复关键):不写的话沉浸式标题栏下永远是系统黑底 -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid
            x:Name="AppTitleBar"
            Height="40"
            Padding="14,0,150,0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="三角洲一键颜色管理" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.55"
                    Text="v2.0 WinUI" />
            </StackPanel>
            <!-- 主题开关(滑动开关 + 月亮/太阳图标,右侧避开系统按钮) -->
            <ToggleSwitch
                x:Name="ThemeSwitch"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Toggled="ThemeSwitch_Toggled">
                <ToggleSwitch.OnContent>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Glyph="&#xE708;" />
                </ToggleSwitch.OnContent>
                <ToggleSwitch.OffContent>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Glyph="&#xE706;" />
                </ToggleSwitch.OffContent>
            </ToggleSwitch>
        </Grid>

        <!-- 主内容 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16,4,16,12" Spacing="12">

                <!-- 显示器 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="显示器" />
                        <ComboBox
                            x:Name="CmbDisplay"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="选择显示器" />
                    </StackPanel>
                </Border>

                <!-- 画面调节 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="画面调节（拖动即时预览）" />

                        <StackPanel Margin="0,8,0,0">
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Text="亮度(B)" />
                                <TextBlock
                                    x:Name="LblBrightness"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider
                                x:Name="SldBrightness"
                                StepFrequency="1"
                                ValueChanged="LutSlider_ValueChanged" />
                        </StackPanel>

                        <StackPanel>
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Text="对比度(C)" />
                                <TextBlock
                                    x:Name="LblContrast"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider
                                x:Name="SldContrast"
                                StepFrequency="1"
                                ValueChanged="LutSlider_ValueChanged" />
                        </StackPanel>

                        <StackPanel>
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Text="灰度系数(g)" />
                                <TextBlock
                                    x:Name="LblGrayscale"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider
                                x:Name="SldGrayscale"
                                StepFrequency="1"
                                ValueChanged="LutSlider_ValueChanged" />
                        </StackPanel>

                        <StackPanel>
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Text="数字颜色格式(I)" />
                                <TextBlock
                                    x:Name="LblVibrance"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider
                                x:Name="SldVibrance"
                                StepFrequency="1"
                                ValueChanged="VibranceSlider_ValueChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ICC 配置 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="ICC 配置文件（选择即生效）" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="CmbIcc"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="CmbIcc_SelectionChanged" />
                            <Button
                                Grid.Column="1"
                                Click="BtnImportIcc_Click"
                                Content="导入 ICC…" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 配置方案 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="配置方案（双击直接应用）" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListView
                                x:Name="LstProfiles"
                                MinHeight="170"
                                DoubleTapped="LstProfiles_DoubleTapped"
                                SelectionMode="Single" />
                            <StackPanel
                                Grid.Column="1"
                                Width="190"
                                Spacing="8">
                                <Button
                                    Click="BtnSave_Click"
                                    Content="保存当前为新方案"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Click="BtnApplyProfile_Click"
                                    Content="应用选中方案"
                                    HorizontalAlignment="Stretch" />
                                <Button
                                    Click="BtnDeleteProfile_Click"
                                    Content="删除选中方案"
                                    HorizontalAlignment="Stretch" />
                                <Button
                                    Click="BtnExportProfile_Click"
                                    Content="导出方案"
                                    HorizontalAlignment="Stretch" />
                                <Button
                                    Click="BtnImportProfile_Click"
                                    Content="导入方案"
                                    HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 + 状态栏 -->
        <Grid
            Grid.Row="2"
            Padding="16,10"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="BtnReset"
                    Background="#FF962C2C"
                    Click="BtnReset_Click"
                    Content="恢复默认"
                    Foreground="White" />
                <Button Click="BtnDiag_Click" Content="NV诊断" />
            </StackPanel>
            <TextBlock
                x:Name="StatusText"
                Grid.Row="1"
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
